# MzPedal's sound card and block size, read by its service at start.
# Installed as /etc/default/mzpedal; after changing it:  sudo systemctl restart mzpedal
#
# --device   the sound card, by any part of its name: mzpedal --list shows them
# --buffer   samples a block: 64 is about 1.3 ms at 48 kHz; 32 if the Pi keeps up, 128 if not
# --input    which input the guitar is on, from 1
#
# A name with a space in it will not do here - give a part of it without one.

MZPEDAL_ARGS="--rate 48000 --buffer 64 --input 1"
